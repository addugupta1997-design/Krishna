# Admin credentials — set your own secure username and password.
# On Vercel, set these in Project Settings → Environment Variables (never commit real values).
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="change-this-to-a-strong-password"

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
JWT_SECRET="replace-with-a-long-random-server-only-secret"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Cashfree Payment Gateway. Keep credentials server-side; never expose these in Vite variables.
# Start with sandbox credentials from the Cashfree merchant dashboard.
CASHFREE_MODE="sandbox"
CASHFREE_CLIENT_ID=""
CASHFREE_CLIENT_SECRET=""
# Use the public HTTPS address of this app for Cashfree return/webhook callbacks.
# For local webhook testing, use a temporary HTTPS tunnel to localhost:3000.
PUBLIC_BASE_URL="http://localhost:3000"

# Production payments require both explicit approvals below, a production credential pair,
# a valid HTTPS PUBLIC_BASE_URL, and confirmed delivery settings in the admin panel.
CASHFREE_LIVE_ENABLED="false"
CASHFREE_LIVE_CHECKLIST_COMPLETED="false"

# Supabase Auth - copy from Supabase dashboard > Settings > API
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
